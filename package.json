    "@angular/platform-browser": "^20.1.0",
    "@angular/router": "^20.1.0",
    "@ng-icons/core": "^29.10.0",
    "@ng-icons/lucide": "^29.10.0",
    "@tailwindcss/postcss": "^4.1.18",
    "class-variance-authority": "^0.7.0",
